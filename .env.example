# ============================================
# PRODUCTION ENVIRONMENT VARIABLES TEMPLATE
# ============================================

# NODE ENVIRONMENT
NODE_ENV=development

# ============ DATABASE ============
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sipagi
DB_USER=postgres
DB_PASSWORD=your_secure_password_here
DB_SSL=false

# ============ REDIS/CACHE ============
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ============ JWT/AUTH ============
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d
REFRESH_TOKEN_EXPIRE=30d

# ============ API ============
API_PORT=3000
API_URL=http://localhost:3000
API_CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# ============ FRONTEND ============
VITE_API_URL=http://localhost:3000
VITE_APP_NAME=SIPAGI

# ============ ENCRYPTION ============
ENCRYPTION_KEY=your_32_char_encryption_key_here_1234
ENCRYPTION_IV=your_16_char_iv_key_1234567890ab

# ============ WHATSAPP (FONNTE) ============
FONNTE_TOKEN=your_fonnte_api_token_here
FONNTE_WEBHOOK_SECRET=your_webhook_secret_here
FONNTE_PROXY_URL=https://your-edge-function-url.supabase.co/functions/v1/fonnte-proxy

# ============ SUPABASE (ALTERNATIVE) ============
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ============ LOGGING ============
LOG_LEVEL=debug
LOG_FILE=logs/app.log

# ============ MONITORING ============
SENTRY_DSN=
POSTHOG_API_KEY=

# ============ EMAIL (Optional) ============
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=noreply@sipagi.sman10pinrang.sch.id

# ============ SCHOOL INFO ============
SCHOOL_NAME=SMAN 10 Pinrang
SCHOOL_LOGO_URL=https://sman10pinrang.sch.id/wp-content/uploads/2021/02/cropped-cropped-pake-logo-ini-sman-10-png.png
SCHOOL_CONTACT=

# ============ SCHEDULER ============
SCHEDULER_ENABLED=true
SCHEDULER_AUTO_ALPA_TIME=08:00
SCHEDULER_SEND_WA=true
SCHEDULER_TIMEZONE=Asia/Jakarta

# ============ FEATURES ============
FEATURE_QR_SCAN=true
FEATURE_MANUAL_INPUT=true
FEATURE_AUTO_ALPA=true
FEATURE_WA_NOTIFICATION=true
FEATURE_EXCEL_EXPORT=true
