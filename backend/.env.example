# ============ Environment ============
NODE_ENV=development
PORT=3000

# ============ Database ============
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sipagi
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false

# ============ Redis ============
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ============ JWT ============
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRE=7d
REFRESH_TOKEN_EXPIRE=30d

# ============ API Config ============
API_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# ============ Encryption ============
ENCRYPTION_KEY=your32charencryptionkeychange1234

# ============ WhatsApp (Fonnte) ============
FONNTE_TOKEN=your-fonnte-api-token
FONNTE_WEBHOOK_SECRET=your-webhook-secret

# ============ Logging ============
LOG_LEVEL=debug

# ============ Features ============
FEATURE_QR_SCAN=true
FEATURE_AUTO_ALPA=true
FEATURE_WA_NOTIFICATION=true

# ============ Scheduler ============
SCHEDULER_AUTO_ALPA_TIME=08:00
SCHEDULER_TIMEZONE=Asia/Jakarta
